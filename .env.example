# Copy to .env and fill in. Never commit .env.

# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://...).
TTK_DATABASE_URL=sqlite:///data/time_to_kill.db

# Odds providers. Optional: without a key, odds ingestion is disabled.
# PropLine (https://prop-line.com): free tier 1,000 requests/day; preferred for collection.
TTK_PROPLINE_API_KEY=
# The Odds API (https://the-odds-api.com): free tier 500 credits/month.
TTK_ODDS_API_KEY=

# Currency per betting unit, for performance reports (default 1 = units are currency).
TTK_UNIT_SIZE=1

# Books you can actually bet at; best price and EV use only these (comma-separated
# keys, see `ttk card`). Unset = every book, including exchanges/prediction markets.
TTK_BETTABLE_BOOKS=

# Odds older than this many minutes are not CURRENT and cannot produce a QUALIFIED bet.
TTK_ODDS_MAX_AGE_MINUTES=30

# Qualification defaults (see docs/MODEL-GOVERNANCE.md). Probabilities are 0-1.
TTK_MIN_MODEL_PROBABILITY=0.56
TTK_MIN_EDGE=0.02
TTK_MIN_EV=0.0
TTK_MIN_DATA_QUALITY=ACCEPTABLE
